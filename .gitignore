# Local inputs and generated artifacts; keep them out of public commits.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Safety net for local spreadsheet exports anywhere in the tree.
*.xlsx
*.xls
*.csv

# Generated result tables - regenerated by the synthetic workflow.
reports/tables/*

# Saved model files (may contain implicit data structure)
models/*.joblib
models/*.pkl

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# OS / editor artefacts
.DS_Store
Thumbs.db
*.swp
.vscode/
